#!/bin/bash

set -o pipefail

# ============================================================
# MC LAUNCHER — SEARCH
# ============================================================

MC_VERSION="0.1.0"
MODRINTH_API="https://api.modrinth.com/v2"

MC_COMMAND_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
MC_DIR="$(cd "$MC_COMMAND_DIR/.." && pwd)"

GAME_DIR="${MC_GAME_DIR:-$HOME/.minecraft}"
VERSION_DB="$MC_DIR/data/versions.json"

# Shared UI
if [[ -f "$MC_COMMAND_DIR/ui.sh" ]]; then
    source "$MC_COMMAND_DIR/ui.sh"
fi

# ============================================================
# Colors
# ============================================================

if [[ -t 1 ]]; then
    BOLD=$'\033[1m'
    DIM=$'\033[2m'
    RED=$'\033[31m'
    GREEN=$'\033[32m'
    YELLOW=$'\033[33m'
    CYAN=$'\033[36m'
    RESET=$'\033[0m'
else
    BOLD=""
    DIM=""
    RED=""
    GREEN=""
    YELLOW=""
    CYAN=""
    RESET=""
fi

# ============================================================
# Helpers
# ============================================================

die() {
    printf '%bError:%b %s\n' "$RED" "$RESET" "$*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 ||
        die "Required command '$1' is not installed."
}

trim_description() {
    local text="$1"

    text="${text//$'\n'/ }"
    text="${text//$'\r'/ }"

    if (( ${#text} > 100 )); then
        printf '%s...' "${text:0:97}"
    else
        printf '%s' "$text"
    fi
}

# ============================================================
# Help
# ============================================================

usage() {
    cat <<EOF

${BOLD}${CYAN}mc search${RESET} — Search Minecraft content

${BOLD}Usage${RESET}
  mc search <type> [query] [options]

${BOLD}Types${RESET}
  mod          Mods
  modpack      Modpacks
  shader       Shaders
  resourcepack Resource packs
  versions     Minecraft versions

${BOLD}Examples${RESET}
  mc search mod sodium
  mc search mod sodium --version 1.21.8
  mc search mod sodium --loader fabric
  mc search shader complementary
  mc search resourcepack faithful
  mc search modpack

  mc search versions
  mc search versions --snapshot
  mc search versions 1.21
  mc search versions 1.21 --snapshot

${BOLD}Options${RESET}
  --version VERSION    Minecraft version filter
  --loader LOADER      Mod loader/category filter
  --limit NUMBER       Number of results
  --snapshot           Show snapshots

EOF
}

# ============================================================
# Minecraft Versions
# ============================================================

search_versions() {

    local query=""
    local snapshot=false

    while [[ $# -gt 0 ]]; do

        case "$1" in

            --snapshot)
                snapshot=true
                shift
                ;;

            --help|-h)
                usage
                return 0
                ;;

            --*)
                die "Unknown option '$1'."
                ;;

            *)
                if [[ -z "$query" ]]; then
                    query="$1"
                else
                    die "Unexpected argument '$1'."
                fi
                shift
                ;;

        esac

    done

    [[ -f "$VERSION_DB" ]] ||
        die "Minecraft version database not found.

Run:
  mc update database"

    require_command jq

    if ! jq -e . "$VERSION_DB" >/dev/null 2>&1; then
        die "Minecraft version database contains invalid JSON."
    fi

    printf '\n'
    printf '%b%sMinecraft versions%s%b\n' \
        "$BOLD" "$CYAN" "$RESET" "$RESET"
    printf '\n'

    # --------------------------------------------------------
    # Browse newest versions
    # --------------------------------------------------------

    if [[ -z "$query" ]]; then

        if [[ "$snapshot" == true ]]; then

            printf '%b10 newest snapshots:%b\n\n' \
                "$DIM" "$RESET"

            jq -r '
                .versions
                | map(select(.type == "snapshot"))
                | .[:10]
                | .[]
                | [.id, .releaseTime]
                | @tsv
            ' "$VERSION_DB" |
            while IFS=$'\t' read -r id release_time; do

                printf '  %b%-22s%b %b%-10s%b %s\n' \
                    "$YELLOW" \
                    "$id" \
                    "$RESET" \
                    "$YELLOW" \
                    "snapshot" \
                    "$RESET" \
                    "${release_time:0:10}"

            done

        else

            printf '%b10 newest releases:%b\n\n' \
                "$DIM" "$RESET"

            jq -r '
                .versions
                | map(select(.type == "release"))
                | .[:10]
                | .[]
                | [.id, .releaseTime]
                | @tsv
            ' "$VERSION_DB" |
            while IFS=$'\t' read -r id release_time; do

                printf '  %b%-22s%b %b%-10s%b %s\n' \
                    "$GREEN" \
                    "$id" \
                    "$RESET" \
                    "$GREEN" \
                    "release" \
                    "$RESET" \
                    "${release_time:0:10}"

            done

        fi

        printf '\n'
        printf '%bUse --snapshot to show snapshots.%b\n' \
            "$DIM" "$RESET"
        printf '\n'

        return 0
    fi

    # --------------------------------------------------------
    # Search versions
    # --------------------------------------------------------

    if [[ "$snapshot" == true ]]; then
        printf '%bSnapshots matching:%b %b%s%b\n\n' \
            "$DIM" "$RESET" "$BOLD" "$query" "$RESET"
    else
        printf '%bReleases matching:%b %b%s%b\n\n' \
            "$DIM" "$RESET" "$BOLD" "$query" "$RESET"
    fi

    local results

    results="$(
        jq -r \
            --arg query "$query" \
            --arg type "$( [[ "$snapshot" == true ]] && echo snapshot || echo release )" '
            .versions[]
            | select(
                .type == $type
                and
                (
                    (.id // "")
                    | ascii_downcase
                    | contains($query | ascii_downcase)
                )
            )
            | [.id, .releaseTime]
            | @tsv
        ' "$VERSION_DB"
    )"

    if [[ -z "$results" ]]; then

        printf '%bNo matching versions found.%b\n\n' \
            "$YELLOW" "$RESET"

        return 0
    fi

    local index=1

    while IFS=$'\t' read -r id release_time; do

        if [[ "$snapshot" == true ]]; then
            type_color="$YELLOW"
            type_label="snapshot"
        else
            type_color="$GREEN"
            type_label="release"
        fi

        printf '  %b%2d%b  %-22s %b%-10s%b %s\n' \
            "$CYAN" \
            "$index" \
            "$RESET" \
            "$id" \
            "$type_color" \
            "$type_label" \
            "$RESET" \
            "${release_time:0:10}"

        ((index++))

    done <<< "$results"

    printf '\n'
}

# ============================================================
# Modrinth API
# ============================================================

modrinth_search() {

    local query="$1"
    local project_type="$2"
    local version="$3"
    local loader="$4"
    local limit="$5"

    local facets

    facets="$(
        jq -cn \
            --arg type "$project_type" \
            --arg version "$version" \
            --arg loader "$loader" '
            [
                ["project_type:" + $type]
            ]
            +
            (
                if $version != ""
                then [["versions:" + $version]]
                else []
                end
            )
            +
            (
                if $loader != ""
                then [["categories:" + $loader]]
                else []
                end
            )
        '
    )"

    curl \
        --fail \
        --silent \
        --show-error \
        --location \
        --retry 3 \
        --connect-timeout 10 \
        --max-time 30 \
        --get \
        "$MODRINTH_API/search" \
        --data-urlencode "limit=$limit" \
        --data-urlencode "index=relevance" \
        --data-urlencode "facets=$facets" \
        ${query:+--data-urlencode "query=$query"} \
        -H "User-Agent: mc-launcher/${MC_VERSION}" \
        -H "Accept: application/json"
}

# ============================================================
# Modrinth Search
# ============================================================

search_modrinth() {

    local project_type="$1"
    local query="${2:-}"

    shift 2

    local version=""
    local loader=""
    local limit=10

    while [[ $# -gt 0 ]]; do

        case "$1" in

            --version)

                [[ -n "${2:-}" ]] ||
                    die "--version requires a value."

                version="$2"
                shift 2
                ;;

            --loader)

                [[ -n "${2:-}" ]] ||
                    die "--loader requires a value."

                loader="$2"
                shift 2
                ;;

            --limit)

                [[ -n "${2:-}" ]] ||
                    die "--limit requires a value."

                [[ "$2" =~ ^[0-9]+$ ]] ||
                    die "--limit must be a number."

                if (( 10#$2 < 1 || 10#$2 > 100 )); then
                    die "--limit must be between 1 and 100."
                fi

                limit="$2"
                shift 2
                ;;

            --help|-h)

                usage
                return 0
                ;;

            --*)

                die "Unknown option '$1'."
                ;;

            *)

                die "Unexpected argument '$1'."
                ;;

        esac

    done

    require_command curl
    require_command jq

    printf '\n'

    printf '%bSearching Modrinth%b\n' \
        "$BOLD$CYAN" "$RESET"

    printf '%bType:%b %s\n' \
        "$DIM" "$RESET" "$project_type"

    if [[ -n "$query" ]]; then
        printf '%bQuery:%b %s\n' \
            "$DIM" "$RESET" "$query"
    else
        printf '%bQuery:%b %s\n' \
            "$DIM" "$RESET" "top projects"
    fi

    [[ -n "$version" ]] &&
        printf '%bMinecraft:%b %s\n' \
            "$DIM" "$RESET" "$version"

    [[ -n "$loader" ]] &&
        printf '%bLoader:%b %s\n' \
            "$DIM" "$RESET" "$loader"

    printf '\n'

    local response

    if ! response="$(
        modrinth_search \
            "$query" \
            "$project_type" \
            "$version" \
            "$loader" \
            "$limit"
    )"; then

        die "Could not reach Modrinth API."
    fi

    if ! jq -e '
        type == "object"
        and
        (.hits | type == "array")
    ' >/dev/null 2>&1 <<< "$response"; then

        printf '%bModrinth response:%b\n' \
            "$RED" "$RESET" >&2

        printf '%s\n' "$response" >&2

        die "Modrinth returned invalid search data."
    fi

    local count

    count="$(jq '.hits | length' <<< "$response")"

    printf '%b%s results%b\n\n' \
        "$BOLD$CYAN" \
        "$count" \
        "$RESET"

    if (( count == 0 )); then

        printf '%bNo results found.%b\n\n' \
            "$YELLOW" "$RESET"

        return 0
    fi

    jq -r '
        .hits
        | to_entries[]
        | [
            (.key + 1),
            (.value.title // ""),
            (.value.description // ""),
            (.value.downloads // 0),
            (.value.slug // "")
        ]
        | @tsv
    ' <<< "$response" |
    while IFS=$'\t' read -r index title description downloads slug; do

        printf '%b%2s%b  %b%s%b\n' \
            "$CYAN" \
            "$index" \
            "$RESET" \
            "$BOLD" \
            "$title" \
            "$RESET"

        if [[ -n "$description" ]]; then

            description="$(trim_description "$description")"

            printf '     %b%s%b\n' \
                "$DIM" \
                "$description" \
                "$RESET"

        fi

        printf '     %bDownloads:%b %s  %bSlug:%b %s\n\n' \
            "$DIM" \
            "$RESET" \
            "$downloads" \
            "$DIM" \
            "$RESET" \
            "$slug"

    done
}

# ============================================================
# Main
# ============================================================

if [[ $# -eq 0 ]]; then
    usage
    exit 1
fi

TYPE="$1"
shift

case "$TYPE" in

    versions|version)

        # IMPORTANT:
        # Pass ALL arguments so:
        # search versions 1.21 --snapshot
        # works correctly.
        search_versions "$@"
        ;;

    mod|modpack|shader|resourcepack)

        QUERY=""

        if [[ $# -gt 0 && "$1" != --* ]]; then
            QUERY="$1"
            shift
        fi

        search_modrinth \
            "$TYPE" \
            "$QUERY" \
            "$@"
        ;;

    -h|--help)

        usage
        ;;

    *)

        printf '\n'
        printf '%bError:%b unknown search type "%s"\n' \
            "$RED" "$RESET" "$TYPE"

        printf '\n'
        printf '%bValid types:%b\n\n' \
            "$BOLD" "$RESET"

        printf '  mod\n'
        printf '  modpack\n'
        printf '  shader\n'
        printf '  resourcepack\n'
        printf '  versions\n'
        printf '\n'

        exit 1
        ;;

esac